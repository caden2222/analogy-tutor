# Create .env locally from this file. Never commit .env or paste your key into chat.
GROQ_API_KEY=replace_with_your_key
GROQ_MODEL=openai/gpt-oss-120b
MODEL_TIMEOUT_MS=25000
MODEL_MAX_OUTPUT_TOKENS=1024
MODEL_CONTEXT_CHARS=8000
# Local safeguards, not provider billing controls. Counts reset when Node restarts.
GENERATED_REQUESTS_PER_MINUTE=2
GENERATED_REQUESTS_PER_DAY=50
